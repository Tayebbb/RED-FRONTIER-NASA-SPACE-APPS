# --- Godot: import cache, editor state and runtime caches (regenerated by `godot --import` / scripts/godot_sync.py)
.godot/
godot/.godot/
godot/logs/
godot/assets/*_voxelgi.res
*.translation

# --- Blender: automatic backups and autosaves
*.blend[0-9]
*.blend[0-9][0-9]
*.blend@
*_autosave.blend
quit.blend

# --- Python
__pycache__/
*.pyc

# --- Logs and scratch (the Blender launcher uses tmp/ as TEMP)
*.log
tmp/*
!tmp/.gitkeep

# --- OS / editor clutter
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- RF-01 character: development sources stay local (Blender sources, review renders, bakes, intermediate exports)
# The game uses godot/assets/characters/rf01/RF01_Engineer.glb (the one runtime copy). Rebuild: art/character/README.md
art/character/source/
art/character/export/
art/character/textures/game/
art/character/renders/**
!art/character/renders/**/
!art/character/renders/RF01_Hair_BEFORE_AFTER.png
!art/character/renders/cp1_body/CP1_proportions_sheet.png
!art/character/renders/cp3_hero/CP3_turntable_sheet.png
!art/character/renders/game_final/RF01_Game_Character_sheet.png
