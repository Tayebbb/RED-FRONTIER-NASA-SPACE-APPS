; Red Frontier - Hangar import test project (Godot 4.7)
config_version=5

[application]

config/name="Red Frontier Hangar Test"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://game/facility_game.tscn"

[autoload]

MissionStateAutoload="*res://state/mission_state_autoload.gd"

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="forward_plus"
occlusion_culling/use_occlusion_culling=true
reflections/reflection_atlas/reflection_count=8
